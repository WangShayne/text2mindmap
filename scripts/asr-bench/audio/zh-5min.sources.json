[
 {
  "fleurs_id": "1660",
  "file": "7976743456431177516.wav",
  "seconds": 11.4,
  "text": "浪漫主义具有很强的文化决定论色彩。这源于歌德、费希特和施莱格尔等作家。"
 },
 {
  "fleurs_id": "1661",
  "file": "1868048601472473390.wav",
  "seconds": 12.96,
  "text": "他没有设定削减数额，只是表示将根据中国的经济产出来决定数额。"
 },
 {
  "fleurs_id": "1662",
  "file": "15556592618355765026.wav",
  "seconds": 9.9,
  "text": "合金基本上由两种或以上金属混合而成。不要忘记一点，元素周期表上有很多元素。"
 },
 {
  "fleurs_id": "1664",
  "file": "5581030602292881199.wav",
  "seconds": 7.92,
  "text": "搅动两种干粉使其混合，然后用干净的湿手把它们揉成一个球。"
 },
 {
  "fleurs_id": "1666",
  "file": "11031078104467854733.wav",
  "seconds": 8.16,
  "text": "你也可以咨询除贵国以外其他政府的建议，但他们的建议是为他们的公民而制定的。"
 },
 {
  "fleurs_id": "1667",
  "file": "206679170921238609.wav",
  "seconds": 10.92,
  "text": "一般来说，当管理者开始领导过去的同事时，会出现两种行为。一种情况是，他们会努力与团队成员保持“亲密关系”。"
 },
 {
  "fleurs_id": "1669",
  "file": "16010467194508249966.wav",
  "seconds": 5.76,
  "text": "警察局长钱德拉·谢卡尔·索兰基说，被告人出庭时都蒙住了脸。"
 },
 {
  "fleurs_id": "1672",
  "file": "12601036378860326355.wav",
  "seconds": 13.9,
  "text": "小心不要让衣服变得太热（这可能会产生收缩现象，在极端情况下会把衣服烤焦）。"
 },
 {
  "fleurs_id": "1673",
  "file": "6897063611136666657.wav",
  "seconds": 8.58,
  "text": "在独立战争期间，十三个州最初根据《联邦条例》组成了弱小的中央政府（国会是其唯一的组成部分）。"
 },
 {
  "fleurs_id": "1674",
  "file": "15619666715819820695.wav",
  "seconds": 8.88,
  "text": "在某些地区，水煮一分钟就足够了，在其他地区则需要几分钟的时间。"
 },
 {
  "fleurs_id": "1676",
  "file": "17609781541012569203.wav",
  "seconds": 7.74,
  "text": "与所有南非国家公园一样，该公园每天都收取养护费和门票费。"
 },
 {
  "fleurs_id": "1677",
  "file": "2696764943147854999.wav",
  "seconds": 6.3,
  "text": "如今，唯一不能向后折叠翅膀的昆虫是蜻蜓和蜉蝣。"
 },
 {
  "fleurs_id": "1679",
  "file": "15514325222679879585.wav",
  "seconds": 9.68,
  "text": "空中铁匠乐队已经取消了他们巡回演唱会的剩余场次。"
 },
 {
  "fleurs_id": "1680",
  "file": "3685895179043714973.wav",
  "seconds": 14.2,
  "text": "老虎是全能运动员，它会攀爬（虽然攀爬能力不是很强）、游泳、跳远，拉力能达到人类大力士的五倍。"
 },
 {
  "fleurs_id": "1681",
  "file": "14066003160545361452.wav",
  "seconds": 13.32,
  "text": "实验是一种用来消除一个或多个可能性假设的试验，不过，实验并不是唯一的方法。提出问题及进行观察也可以指导科学研究。"
 },
 {
  "fleurs_id": "1683",
  "file": "8477978912207506196.wav",
  "seconds": 11.7,
  "text": "还是有许多男女在这里幸存了下来，他们如今仍然健在；而更多人的亲人，有的在那里被屠杀，有的一直做苦工到死，犹太人和非犹太人都是如此。"
 },
 {
  "fleurs_id": "1686",
  "file": "10852536777113131618.wav",
  "seconds": 8.22,
  "text": "因此，一个组织在共同努力克服障碍的过程中，往往会带来新的创新流程，以满足客户的需求。"
 },
 {
  "fleurs_id": "1687",
  "file": "6567034835218108721.wav",
  "seconds": 8.22,
  "text": "由于分离和重组，变异在每一代的两个库之间来回变动。"
 },
 {
  "fleurs_id": "1688",
  "file": "14341578705184191215.wav",
  "seconds": 12.54,
  "text": "从传统意义上讲，海军的任务是确保国家保持运输人员和货物的能力，同时，干扰敌人运输其人员和货物的能力。"
 },
 {
  "fleurs_id": "1689",
  "file": "14550638651919221566.wav",
  "seconds": 17.1,
  "text": "欧洲是片面积相对较小但有着许多独立国家的大陆。在通常情况下，穿越多个国家旅行意味着必须多次经历签证申请和护照检查。"
 },
 {
  "fleurs_id": "1690",
  "file": "3819321501973613113.wav",
  "seconds": 20.08,
  "text": "我们同意美国奥委会的声明，与其吊销执照，不如在我们组织内部继续推进有意义的变革，可能更有利于维护运动员和俱乐部的利益及其运动。"
 },
 {
  "fleurs_id": "1691",
  "file": "1212046656299271869.wav",
  "seconds": 14.32,
  "text": "在某些航线上，大型公司有自己的飞机，但对于其他航线和小公司来说，就有问题了。"
 },
 {
  "fleurs_id": "1692",
  "file": "17639585860488007329.wav",
  "seconds": 11.0,
  "text": "日本原子能机构表示，核电站检测出了放射性物质铯和碘。"
 },
 {
  "fleurs_id": "1694",
  "file": "5703934790809020157.wav",
  "seconds": 8.04,
  "text": "孩子们因为各种原因被寄养，原因有被忽视、被虐待，甚至是被勒索。"
 },
 {
  "fleurs_id": "1696",
  "file": "4977600098624265441.wav",
  "seconds": 11.46,
  "text": "该大学的研究人员表示，这两种化合物相互作用形成的晶体可能会造成肾脏功能障碍。"
 },
 {
  "fleurs_id": "1697",
  "file": "16704409640833254127.wav",
  "seconds": 8.22,
  "text": "他一直无法用药物来缓解疼痛，因为比赛禁止参赛者服用这些药物。"
 },
 {
  "fleurs_id": "1698",
  "file": "15961183399874766018.wav",
  "seconds": 11.38,
  "text": "宇宙中的一切都由物质构成，而所有的物质都由被称为原子的微小粒子组成。"
 }
]