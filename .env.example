# Copy to .env and fill in. Every value is optional; the app starts without any of them.

# --- LLM (any OpenAI-compatible API). The admin can override these in Settings. ---
# Base URL including the version path, e.g. https://api.openai.com/v1,
# https://api.deepseek.com/v1, https://openrouter.ai/api/v1, http://host.docker.internal:11434/v1 (Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_MS=180000
# Texts longer than this many characters are split into parts, outlined, then merged.
# LLM_CHUNK_CHARS=12000
# MAX_INPUT_CHARS=200000

# --- Security ---
# Used to encrypt the API key saved in Settings. If empty, one is generated into data/secret.key.
# Generate: openssl rand -hex 32
APP_SECRET=
# Create the admin on first start (otherwise use the one-time setup page).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please
# Session cookie "Secure" flag: auto (HTTPS detected), true or false.
# COOKIE_SECURE=auto
# Set to true behind a reverse proxy so X-Forwarded-For/-Proto are trusted.
# TRUST_PROXY=false
# SESSION_DAYS=30

# --- docker compose port mapping ---
# BIND_ADDRESS=127.0.0.1
# HOST_PORT=3000
