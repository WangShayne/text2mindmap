# Copy to .env and fill in. Every value is optional; the app starts without any of them.

# --- LLM (any OpenAI-compatible API). The admin can override these in Settings. ---
# Base URL including the version path, e.g. https://api.openai.com/v1,
# https://api.deepseek.com/v1, https://openrouter.ai/api/v1.
# A server on the Docker host (Ollama, New API, one-api…): http://host.docker.internal:<port>/v1,
# e.g. http://host.docker.internal:11434/v1 for Ollama. Not localhost: that is the container itself.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_MS=180000
# Texts longer than this many characters are split into parts, outlined, then merged.
# LLM_CHUNK_CHARS=12000
# MAX_INPUT_CHARS=200000

# --- Security ---
# Used to encrypt the API key saved in Settings. Recommended. If empty, one is generated into
# data/secret.key: then always move the whole data/ directory together. Generate: openssl rand -hex 32
APP_SECRET=
# Create the admin on first start. Otherwise open the setup page and enter the one-time
# setup code printed by `docker compose logs text2mindmap`.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please
# Session cookie "Secure" flag: auto (HTTPS detected), true or false.
# COOKIE_SECURE=auto
# Required behind a reverse proxy: true (one proxy) or the number of proxies in front of the app.
# Then X-Forwarded-For/-Proto/-Host from the proxy are trusted. Leave false when exposed directly.
# TRUST_PROXY=false
# SESSION_DAYS=30

# --- docker compose port mapping ---
# BIND_ADDRESS=127.0.0.1
# HOST_PORT=3000
